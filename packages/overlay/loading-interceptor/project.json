{
  "name": "overlay-loading-interceptor",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/overlay/loading-interceptor/src",
  "prefix": "muxima",
  "tags": [],
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/packages/overlay/loading-interceptor"],
      "options": {
        "project": "packages/overlay/loading-interceptor/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/overlay/loading-interceptor/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/overlay/loading-interceptor/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/overlay/loading-interceptor/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
