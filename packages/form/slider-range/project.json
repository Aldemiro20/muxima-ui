      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/form/slider-range/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/form/slider-range/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/form/slider-range/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    }
  }
}

