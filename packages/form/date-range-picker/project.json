      "options": {
        "project": "packages/form/date-range-picker/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/form/date-range-picker/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/form/date-range-picker/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    }
  }
}

