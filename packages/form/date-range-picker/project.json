{
  "name": "date-range-picker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/form/date-range-picker/src",
  "prefix": "muxima",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
