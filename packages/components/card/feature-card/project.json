{
  "name": "feature-card",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/components/card/feature-card/src",
  "prefix": "muxima",
  "tags": [],
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:ng-packagr",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/components/card/feature-card/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/components/card/feature-card/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/components/card/feature-card/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "tsConfig": "packages/components/card/feature-card/tsconfig.spec.json",
        "polyfills": ["zone.js", "zone.js/testing"]
      }
    }
  }
}
