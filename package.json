{
  "name": "muxima-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run docs:examples && ng serve docs",
    "build": "ng build core && npm run build:docs",
    "build:core": "ng build core",
    "build:docs": "npm run docs:examples && ng build docs",
    "test": "ng test core --watch=false",
    "watch": "ng build core --watch --configuration development",
    "test:a11y": "node scripts/a11y.mjs",
    "docs:examples": "node projects/docs/scripts/extract-examples.mjs && node projects/docs/scripts/extract-blocks.mjs",
    "test:e2e": "playwright test",
    "docs:check-examples": "npm run docs:examples && node scripts/check-examples.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.56.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "axe-core": "^4.14.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "playwright": "^1.56.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
