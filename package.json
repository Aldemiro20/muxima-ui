{
  "name": "muxima-ui",
  "version": "1.0.0",
  "description": "A modern, professional Angular UI component library",
  "keywords": [
    "angular",
    "ui",
    "components",
    "library",
    "design-system",
    "muxima"
  ],
  "homepage": "https://muxima-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aldemiro20/muxima-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Aldemiro20/muxima-ui/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aldemiro Valentim",
    "url": "https://github.com/Aldemiro20"
  },
  "scripts": {
    "dev": "nx serve docs",
    "build": "nx build docs --configuration=production",
    "build:docs": "nx build docs --configuration=production",
    "build:all": "nx run-many --target=build --all --parallel=3 --configuration=production",
    "build:affected": "nx affected --target=build --parallel=3 --configuration=production",
    "test": "nx run-many --target=test --all --parallel=3",
    "test:affected": "nx affected --target=test --parallel=3",
    "lint": "nx run-many --target=lint --all --parallel=3",
    "lint:affected": "nx affected --target=lint --parallel=3",
    "lint:fix": "nx run-many --target=lint --all --parallel=3 --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,html,css,scss}\"",
    "storybook": "nx run storybook-host:storybook",
    "build-storybook": "nx run storybook-host:build-storybook",
    "graph": "nx graph",
    "affected:graph": "nx affected:graph",
    "version:bump": "node tools/scripts/version-bump.js",
    "publish:all": "node tools/scripts/publish-all.js",
    "publish:package": "node tools/scripts/publish-package.js",
    "prepare": "husky install || echo 'Husky not installed'",
    "clean": "nx reset && rm -rf dist node_modules",
    "clean:cache": "nx reset"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.0",
    "@angular/cdk": "^15.2.9",
    "@angular/common": "^15.2.0",
    "@angular/compiler": "^15.2.0",
    "@angular/core": "^15.2.0",
    "@angular/forms": "^15.2.0",
    "@angular/platform-browser": "^15.2.0",
    "@angular/platform-browser-dynamic": "^15.2.0",
    "@angular/router": "^15.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.1502.4",
    "@angular-devkit/build-angular": "^15.2.0",
    "@angular-devkit/core": "~15.2.0",
    "@angular-devkit/schematics": "~15.2.0",
    "@angular-eslint/eslint-plugin": "~15.0.0",
    "@angular-eslint/eslint-plugin-template": "~15.0.0",
    "@angular-eslint/template-parser": "~15.0.0",
    "@angular/cli": "~15.2.0",
    "@angular/compiler-cli": "^15.2.0",
    "@nx/angular": "19.0.4",
    "@nx/eslint": "19.0.4",
    "@nx/eslint-plugin": "19.0.4",
    "@nx/jest": "19.0.4",
    "@nx/js": "19.0.4",
    "@nx/storybook": "19.0.4",
    "@nx/web": "19.0.4",
    "@nx/workspace": "19.0.4",
    "@schematics/angular": "~15.2.0",
    "@storybook/addon-essentials": "^7.5.3",
    "@storybook/angular": "^7.5.3",
    "@storybook/core-server": "^7.5.3",
    "@swc-node/register": "~1.8.0",
    "@swc/core": "~1.3.85",
    "@swc/helpers": "~0.5.2",
    "@types/jasmine": "~4.3.0",
    "@types/jest": "^29.4.0",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "^7.3.0",
    "@typescript-eslint/parser": "^7.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "jasmine-core": "~4.5.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-preset-angular": "~14.0.3",
    "jsonc-eslint-parser": "^2.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "~15.2.2",
    "nx": "19.0.4",
    "postcss": "^8.4.5",
    "postcss-url": "~10.1.3",
    "prettier": "^2.6.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "~4.9.4"
  }
}

