      "@muxima/sidebar": ["libs/sidebar/sidebar/src/index.ts"],
      "@muxima/slider": ["libs/slider/slider/src/index.ts"],
      "@muxima/tabs": ["libs/tabs/tabs/src/index.ts"],
      "@muxima/timeline": ["libs/timeline/timeline/src/index.ts"],
      "@muxima/toggle": ["libs/toggle/toggle/src/index.ts"],
      "@muxima/tooltip": ["libs/tooltip/tooltip/src/index.ts"],
